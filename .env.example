# =============================================================================
# Info Trader Backend — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in your actual values.

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/info_trader
DATABASE_URL_SYNC=postgresql://postgres:password@db:5432/info_trader

# ---- JWT Authentication ----
JWT_SECRET_KEY=change-me-in-production-use-a-random-64-char-hex
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# ---- Alpha Vantage API ----
# Get your free key from: https://www.alphavantage.co/support/#api-key
# Docs: https://www.alphavantage.co/documentation/
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key-here

# ---- Redis (Celery Broker) ----
REDIS_URL=redis://redis:6379/0

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000
